---
// Brand + primary nav shared by the landing page and the docs header.
// `active="docs"` marks the Docs link (mockup: bold, moss underline).
interface Props {
  active?: 'docs';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/calvinyong1/ArabidopsisAnalysisV2';
---

<nav class="site-nav" aria-label="Main">
  <a class="brand" href={`${base}/`}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 22V10"></path><path d="M12 14c-3 0-5-2-5-5 3 0 5 2 5 5z"></path><path d="M12 11c0-3 2-6 6-6 0 4-3 6-6 6z"></path>
    </svg>
    ArabidopsisAnalysisV2
  </a>
  <div class="links">
    <a href={`${base}/#apps`}>Apps</a>
    <a href={`${base}/#whats-new`}>What's new</a>
    <a href={`${base}/#docs`} aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
    <a class="gh" href={repo}>GitHub</a>
  </div>
</nav>

<style>
  .site-nav {
    max-width: var(--nav-max, 1200px);
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
  }
  .brand svg { color: var(--moss); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    text-decoration: none;
    color: var(--ink-2);
    font-weight: 500;
    font-size: 15px;
  }
  .links a:hover { color: var(--ink); }
  .links a[aria-current] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--moss);
  }
  .links a.gh {
    padding: 0 16px;
    border-radius: 8px;
    color: #fff;
    background: var(--ink);
    font-weight: 600;
  }
  .links a.gh:hover { background: var(--ink-2); color: #fff; }
  .links a:focus-visible, .brand:focus-visible { outline: 2px solid var(--moss); outline-offset: 2px; }
</style>
